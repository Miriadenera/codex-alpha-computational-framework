<INFO name="JOBID" value="423b3553-4b43-11f1-b4f2-bc97e148b76b-O" ucd="meta.id;meta.query"/>
<INFO name="JOBNAME" value="Codex Alpha Computational Framework"/>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT TOP 1000
  source_id,
  ra,
  dec,
  parallax,
  pmra,
  pmdec,
  phot_g_mean_mag,
  phot_bp_mean_mag,
  phot_rp_mean_mag,
  bp_rp,
  radial_velocity
FROM gaiadr3.gaia_source
WHERE parallax IS NOT NULL
  AND pmra IS NOT NULL
  AND pmdec IS NOT NULL
  AND phot_g_mean_mag IS NOT NULL
  AND bp_rp IS NOT NULL
  AND radial_velocity IS NOT NULL" ucd="meta.query"/>

